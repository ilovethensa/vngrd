# Generated by ../vngrd-rootfs/scripts/export-seed.sh -- the imported seed,
# not source. Regenerate:
#   (cd ../vngrd-rootfs && ./scripts/export-seed.sh ../vngrd-buildstream/elements/seed)
elements/seed/

# The second prebuilt input: the Rust toolchain fish's build needs. Regenerate:
#   ./scripts/export-rust.sh (after removing the old tree)
elements/toolchain/rust/

# fish's cargo dependencies, vendored because the build sandbox has no
# network. Regenerate:
#   ./scripts/export-vendor.sh (after removing the old tree)
elements/packages/fish/files/vendor/

# dbus-broker's c-util git subprojects, vendored for the same reason.
# Regenerate:
#   ./scripts/export-subprojects.sh (after removing the old tree)
elements/packages/dbus-broker/files/subprojects/

# BuildStream's own working state, if a project-local cache is ever used.
.cache/
__pycache__/
