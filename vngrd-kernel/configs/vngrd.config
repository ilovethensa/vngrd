# Help: Every non-default Kconfig value vngrd makes, and why. Read this file, not kernel.config.
#
# This is the source of truth for the kernel's configuration decisions. kernel.config
# is the expanded .config this fragment is merged onto: ~4500 symbols, regenerated by
# olddefconfig, so a decision written there is neither reviewable in a diff nor stable
# across a kernel bump. A value belongs here if a reviewer would ask "why is that off?"
# -- which is a much shorter list than kernel.config's symbols, and is the whole reason
# this file exists.
#
# It is merged by scripts/build-inner.sh with the kernel's own
# scripts/kconfig/merge_config.sh, the same mechanism the in-tree kernel/configs/*.config
# and arch/x86/configs/*.config fragments go through (scripts/kconfig/Makefile:104-113,
# the `%.config' target: merge_config.sh -m, then olddefconfig). Every value below is
# re-checked against the .config that olddefconfig actually produced, so a value Kconfig
# refuses -- a missing dependency, or a `select' that can only raise a value -- is a build
# failure here rather than a value that silently becomes something else.
#
# Kconfig has no assert primitive: `default' is always user-overridable
# (Documentation/kbuild/kconfig-language.rst:86-89 says so of the same thing), and
# `select' can only raise a value, never lower it. The post-config verification in
# build-inner.sh is therefore the only thing standing behind these values, and it is not
# optional.


# --- Modules -----------------------------------------------------------------
#
# There is no module loader at all, which removes module loading, module signature
# verification, and the module parameter/relocation surface in one decision. Nothing
# ships modules, so this is unused capability rather than a live hole -- which is
# exactly why it is worth a build failure rather than something to remember.
#
# One consequence is not a detail: with MODULES=n, sym_get_type()
# (scripts/kconfig/symbol.c:44-51) reports every tristate as a boolean, so a `=m' left
# anywhere in the base config is silently promoted to `=y' and built in. build-inner.sh
# asserts that no `=m' survives, because nothing else would notice.
#
# A module loader is also what the first rogue driver would need, and what it would pull
# in with it is not limited to whatever happens to ship today. The rest of kernel/module/
# -- MODULE_SIG, MODULE_UNLOAD, MODVERSIONS and the rest -- is all invisible with
# MODULES=n, so those are asserted off in build-inner.sh rather than listed here, where
# they would be unreadable no-ops.
# CONFIG_MODULES is not set


# --- Loading kernel code ----------------------------------------------------
#
# Both kexec syscalls are the unsigned-kernel persistence path: root on the writable
# /etc+/var+/home layer plants an image for the next boot and both Secure Boot and
# dm-verity are bypassed together. CONFIG_KEXEC_FILE is the one that is easy to
# overlook -- it performs no signature check at all unless CONFIG_KEXEC_SIG is also
# set, so it looks like the safer of the two and is not.
#
# KEXEC_CORE, the machinery both of them share, is only reachable through them, so it
# and everything that hangs off it goes with them: KEXEC_JUMP, CRASH_DUMP, and through
# it PROC_VMCORE and VMCORE_INFO. That is why kernel.config's CRASH_DUMP=y does not
# survive: nothing can dump a kernel that cannot be kexec'd.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set


# --- Physical memory --------------------------------------------------------
#
# lockdown=integrity does not close any of these three, and the reason is the same in
# each case: lockdown_is_locked_down() (security/lockdown/lockdown.c:65) denies only
# when kernel_locked_down >= what, and LOCKDOWN_KCORE is enum value 22 while
# LOCKDOWN_INTEGRITY_MAX is 21. The signed command line that closes the other doors in
# this file does not close these.
#
# /dev/mem     lockdown does block writes, but the read side is what matters: the page
#              cache and the dm-verity target's own code are both in physical memory.
#              Compiling it out removes the node rather than arguing about the
#              permission.
# /dev/port    I/O to the legacy ISA port range, an easy one-way door from a uid that
#              can open a device node.
# /proc/kcore  A full physical-RAM read for root, and the same read primitive as
#              /dev/mem, which is why it is listed here too. On x86
#              kc_xlate_dev_mem_ptr is __va(phys) (fs/proc/kcore.c:53-56), so a read
#              walks the entire direct map: the dm-crypt LUKS2 volume key, TPM2/TSS
#              state, the btrfs keyring, and the decrypted page-cache images of the
#              verity'd /usr. It is off at its Kconfig default already (fs/proc/Kconfig
#              :32-39 has no `default', so PROC_KCORE is n unless asked for) and nothing
#              in the tree selects it; this is the same mechanism Android's GKI uses, and
#              the reason it is a decision at all is that kernel.config was seeded from
#              a config that had it on. Two in-tree callers (arch/x86/mm/init_64.c:1398,
#              arch/mips/mm/init.c:461) still compile: kclist_add() is a static inline
#              no-op when PROC_KCORE is unset (include/linux/kcore.h:23-33). Nothing in
#              vngrd's rootfs or initrd reads it -- systemd lists it in
#              MOUNT_INACCESSIBLE (systemd/src/core/namespace.c:150), which hides it
#              from sandboxed services rather than consuming it.
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set


# --- Kernel lockdown --------------------------------------------------------
#
# /usr is verity'd and immutable, but /etc, /var and /home are ordinary read-write
# btrfs, so anything that reaches root can plant a service, rewrite a unit, or replace
# a binary that runs before the login prompt. These make the running kernel
# unmodifiable from there. Note that the floor below is only a floor: it holds even if
# the command line says lockdown=none, so it is what makes the signed
# lockdown=integrity in the UKI command line mean anything.
#
# _EARLY initialises the lockdown LSM before every other one, so nothing can consult a
# policy while the kernel is still unlocked. It is not what makes lockdown=integrity
# work -- lockdown is an early_param (security/lockdown/lockdown.c:53), so the
# parameter is honoured either way -- it is the ordering.
#
# SECURITYFS is here rather than on its own merits: without it
# securityfs_create_dir() returns ENODEV, drivers/char/tpm/eventlog/common.c:115-125
# then `return's before registering anything, and
# /sys/kernel/security/tpm0/binary_bios_measurements does not exist. systemd-pcrlock's
# event_log_load_firmware() read_full_file()s that path with no ENOENT case, which
# makes every pcrlock runtime mode fail. It is also the only way an operator can read
# back /sys/kernel/security/lockdown and confirm the mode actually booted. No other
# securityfs consumer (IMA, EVM, IPE, LoadPin, SafeSetID, AppArmor) is enabled here, so
# the only nodes added are those two.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
# CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE is not set
# CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY is not set
CONFIG_SECURITYFS=y


# --- Default LSM ------------------------------------------------------------
#
# SELinux is compiled in but DAC is the default, because the image ships no policy:
# with DEFAULT_SECURITY_SELINUX the kernel would come up in enforcing mode with
# nothing to load and deny everything. lockdown is in CONFIG_LSM and is active; the
# other names in that list are not built, so the string is only a statement of what
# would be tried in order.
CONFIG_DEFAULT_SECURITY_DAC=y
# CONFIG_DEFAULT_SECURITY_SELINUX is not set


# --- Unprivileged kernel interfaces ----------------------------------------
#
# None of these are reachable by an unprivileged uid on their own, and all of them are
# the raw material of a kernel exploit from one that is. The image uses none.
#
# bpf(2) and its JIT compile attacker-supplied eBPF inside the kernel with a large
#      verifier and JIT surface. Not merely gated: CONFIG_BPF_SYSCALL is not set at
#      all, so there is no syscall to gate.
# userfaultfd  The write-to-an-arbitrary-physical-page primitive, and the reason
#      cross-allocator attacks work at all.
# user namespaces  The default route to a full set of uid/gid and capability
#      credentials an unprivileged process can then use. The image has no use for
#      them: nothing ships a container runtime, and systemd's user services run
#      without them.
# FUSE        A filesystem where the kernel hands the attacker-controlled daemon the
#      ability to return arbitrary page contents into the page cache.
# SysRq      A keyboard-driven root interface (reboot, remount read-only, task
#      dump, kill-all-tasks). The run-vm path has no reason to want it.
# debugfs    Not a filesystem so much as a root-privilege information disclosure
#      with a mount point: /sys/kernel/debug exposes a large fraction of the
#      kernel's internal state, and it has a long CVE history precisely because
#      "who can mount debugfs" and "who is root" are not the same question.
#
# CONFIG_BLK_DEV_IO_TRACE is here because it is the only thing in this configuration
# that forces DEBUG_FS on: it `select's DEBUG_FS (kernel/trace/Kconfig:736) to register
# its block-I/O ftrace events, and `select' can only raise a value, never lower it --
# so asking for `# CONFIG_DEBUG_FS is not set' on its own is a no-op here. The tracing
# events themselves are unused (no bpftrace, trace-cmd or blkparse in the package set),
# and nothing else in the tree selects it, so turning it off is what actually removes
# debugfs.
#
# PROC_PAGE_MONITOR is left on deliberately rather than silently. Asking for it to be
# off was tested against this tree and 7.2.7 answered CONFIG_PROC_PAGE_MONITOR=y: the
# prompt is `bool "Enable /proc page monitoring" if EXPERT' (fs/proc/Kconfig:102), so
# with EXPERT=n the symbol is invisible, and sym_calc_value() applies the `default y' to
# an invisible symbol while discarding the user's value entirely (symbol.c:471-486).
# The only way to turn it off is CONFIG_EXPERT=y, which opens roughly 250 further
# prompts that nothing here has an opinion about -- a much larger change than the one
# /proc/pagemap is worth. So /proc/pagemap, a PFN map readable by root, is still there.
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_USER_NS is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_FUSE_FS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_DEBUG_FS is not set

# perf_event_open is NOT in the list above, and is on: CONFIG_PERF_EVENTS=y. It is left
# alone deliberately rather than overlooked -- it is the one unprivileged kernel
# interface here that is both compiled in and covered by lockdown (LSM_LOCKDOWN_PERF
# blocks the side-channel vectors, not the counter), and turning it off is a larger
# change than this list is making: nothing in the package set ships perf, but ftrace
# also rests on it. It is called out here so the gap is a decision on the record rather
# than an absence nobody noticed.


# --- dm-verity and LUKS2 ----------------------------------------------------
#
# DM_VERITY is the /usr hash check. DM_CRYPT is the LUKS2 container the root partition
# is created into (Encrypt=tpm2 in /usr/lib/repart.d/10-root.conf).
#
# CRYPTO_XTS is not optional here, it is a load-time requirement: LUKS2's default data
# cipher is aes-xts-plain64, so without XTS dm-crypt cannot instantiate the target at
# all -- "device-mapper: table: crypt: Error allocating crypto tfm (-ENOENT)" and no
# root. kernel.config says # CONFIG_CRYPTO_XTS is not set and this fragment is what
# makes that line not the truth; the shipped out/boot/config has it on.
#
# The last two are recorded as they ship, which is the opposite of what a first pass at
# this list would ask for, and the reason is a `select' rather than a judgement:
# DM_INTEGRITY=y selects BLK_DEV_INTEGRITY unconditionally and DM_AUDIT if AUDIT
# (drivers/md/Kconfig:656,661), and AUDIT=y here. Both were written as `# ... is not
# set' in kernel.config and both came out =y in the shipped config -- verified against
# 7.2.7, not assumed. Turning them off means CONFIG_DM_INTEGRITY=n, which is a real
# decision about whether the dm-integrity target should exist at all, and not one this
# list is making.
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_BLK_DEV_INTEGRITY=y
CONFIG_DM_AUDIT=y


# --- TPM --------------------------------------------------------------------
#
# The root partition is created with Encrypt=tpm2 on first boot, so the initrd needs
# /dev/tpmrm0 to enrol and unseal the LUKS2 key. defconfig has no TCG_TPM at all, and
# TCG_TPM alone is the core with no transport -- there is no /dev/tpmrm0 without a bus
# driver.
#
#   TCG_TIS  the FIFO/PTP-FIFO protocol (TIS 1.3). What QEMU's tpm-tis device speaks
#            and what older chips expose. No ACPI, so it works with no firmware help.
#   TCG_CRB  ACPI MSFT0101, the register interface every current x86 TPM exposes.
#            Without it, tpm2_context_new_or_warn() returns "TPM device not found" and
#            the initrd repart run fails, so the root is never created. QEMU masks this
#            omission by also providing tpm-tis, which is why it only shows off QEMU.
#
# They are independent drivers, ~10KB together, and neither selects the other: CRB is
# default TCG_TPM && X86 && ACPI, TIS is default TCG_TPM && X86. HW_RANDOM_TPM is a
# runtime switch inside tpm-chip.c (tpm_is_hwrng_enabled(), drivers/char/tpm/tpm-chip.c
# :500-508) rather than a separate object, which is why it has no Makefile reference;
# it registers the TPM's RNG as a kernel hwrng, so the TPM's entropy reaches
# /dev/hwrng and the kernel CSPRNG. That matters more than usual here, because the
# LUKS2 key is unsealed from a TPM rather than generated locally.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
# These four are a HARD REQUIREMENT, not a preference, and the reason is a
# systemd one rather than a kernel one.
#
# The initrd fixate generator (see PLAN.md, "How the value reaches the
# activation") runs during GENERATOR time -- before udev, before any unit starts.
# It reads /dev/tpmrm0 to authenticate to the TPM NV index holding the root
# volume's fixate hash. A TPM driver built as a module (=m) would not be loaded
# yet, so the node would not exist, and the generator would fail at exactly the
# moment it is needed: before the root is opened.
#
# So: TCG_TPM (the core), at least one of TCG_TIS/TCG_CRB (the transports), and
# DEVTMPFS (which creates the node at probe time, during kernel init, with no
# udev involved) must all be =y. DEVTMPFS is the one most likely to be turned
# into a module by a config tidy-up, because nothing else in a static initrd
# needs it -- and the failure would be a boot that cannot open its own root.
#
# Asserted, not assumed: see vngrd-image/tests/cases/t15-etc-tmpfs.sh for the
# runtime half and the comment on the generator for the build-time half.
CONFIG_HW_RANDOM_TPM=y


# --- /usr filesystem --------------------------------------------------------
#
# EROFS is the /usr filesystem, and repart's Compression=zstd
# (mkosi.repart/10-usr.conf) needs the zstd decompressor. defconfig ships EROFS_FS_ZIP
# with LZMA only, so without this the mount fails with "unsupported compression".
# Selects ZSTD_DECOMPRESS.
CONFIG_EROFS_FS_ZIP_ZSTD=y

# ext4 is REQUIRED, not optional. The writable root is LUKS2 + ext4:
# /usr/lib/repart.d/10-root.conf sets Format=ext4, and systemd-repart execs
# mkfs.ext4 from inside the initrd (src/shared/mkfs-util.c:317,386), so the kernel
# that runs in the initrd has to be able to mount what repart just formatted.
#
# The previous value here was `# CONFIG_EXT4_FS is not set', justified by "there is
# no ext4 partition in any repart definition and no mkfs.ext4 in the package set".
# Both halves were true until the btrfs -> ext4 switch and then stopped being true,
# and the consequence was silent in the worst way: mke2fs is userspace, so repart
# formats the volume successfully, the TPM unseal succeeds, and only then does
# mount(2) on /sysroot return ENODEV because the kernel has no ext4 -- no kernel
# message, and systemd reports it as
#
#     sysroot.mount: Mount process exited, code=exited, status=32/n/a
#     DEPEND  Dependency failed for Initrd Root File System.
#
# EXT4_FS selects JBD2 and CRC16 itself, so neither is listed here.
CONFIG_EXT4_FS=y


# --- Toolchain --------------------------------------------------------------
#
# AGENTS.md: LLVM only, LD=ld.lld. This is a tripwire, not a control:
# CONFIG_LD_IS_LLD is `def_bool $(success,test "$(ld-name)" = LLD)'
# (init/Kconfig:55) where ld-name comes from
# `scripts/ld-version.sh $(LD)' (scripts/Kconfig.include:56), so the value follows the
# linker the build actually used and no config file can set it. It is here so that
# building this tree with anything but lld fails at the config check rather than
# producing a config that disagrees with the vmlinux next to it -- which is exactly
# what the previous build shipped: its boot/config recorded GNU ld 2.40 rather than lld
# 17.0.6, because build-inner.sh passed LD=ld.bfd on the command line, where it wins
# over Makefile:526-537's LLVM=1 assignment: there is no `override LD =' anywhere in
# the tree.
#
# The version is asserted non-zero in build-inner.sh rather than pinned here: a
# hardcoded 170006 would fail the build the day clang 18 lands, which is churn, not a
# security check.
CONFIG_LD_IS_LLD=y


# --- Hardening kept at their (already correct) values ------------------------
#
# Restated so the audited floor is in one file rather than spread over 4500 symbols of
# kernel.config where nobody will look for it. None of these is a vngrd-specific
# decision; they are the x86_64 defconfig values, and they are listed because the
# verification pass in build-inner.sh asserts them and a reviewer should be able to
# find out why.
#
# KASLR, RO text, full canaries, ORC unwinder, and a 1000Hz tick -- the tick is
# systemd-oomd's main input and losing it would make it unresponsive rather than
# merely coarse.
CONFIG_RANDOMIZE_BASE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_UNWINDER_ORC=y
CONFIG_HZ_1000=y

# Retpoline and Indirect Branch Tracking. IBT is on; user shadow stack is off, because
# it needs CPU and glibc support this image does not have. Both are recorded as they
# ship.
CONFIG_X86_KERNEL_IBT=y
# CONFIG_X86_USER_SHADOW_STACK is not set


# --- Boot and platform prerequisites ---------------------------------------
#
# Not security decisions, but non-default values, and a config file that claims to be
# the place non-default values are written has to carry them. Grouped as the EFI boot
# chain, the /dev and /proc /sys filesystems the initrd needs before it can mount
# anything, systemd's own required syscalls, bare-metal NVMe, and the console path
# QEMU's VGA device needs.
#
# EFI: the UKI and systemd-boot are the only boot path, and EFIVAR_FS is where
#      systemd-boot reads its variables from.
# DEVTMPFS: the initrd has no udev to create /dev.
# FHANDLE, INOTIFY_USER, SIGNALFD, TIMERFD, EPOLL, CGROUPS: what systemd itself is
#      built against; dropping any of them is a runtime surprise, not a boot failure.
# NVME: real hardware, not just QEMU's virtio-blk.
# FB/DRM: OVMF's GOP framebuffer plus simpledrm, cirrus and virtio-gpu. Without
#      DRM_SIMPLEDRM the display stays blank after the kernel and the only visible
#      symptom is a black window.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_NET=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_CIRRUS_QEMU=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_QXL=y
