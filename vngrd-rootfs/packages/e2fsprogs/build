#!/bin/sh -e
dest="$1"
cd e2fsprogs-1.47.4

if [ -f /out/usr/lib/ld-linux-x86-64.so.2 ] && [ ! -e /usr/lib/ld-linux-x86-64.so.2 ]; then
    mkdir -p /usr/lib
    ln -sf /out/usr/lib/ld-linux-x86-64.so.2 /usr/lib/ld-linux-x86-64.so.2
fi

# Needed in two places: the rootfs (fsck.ext4 before switch-root, tune2fs) and
# the initrd, because systemd-repart execs mkfs.<fstype> when it first formats the
# root, and there is no mke2fs in the initrd without this package.
#
# mk-initrd-root seeds mkfs.ext4, not mkfs.btrfs. Nothing else is needed there:
# 1.47 compiles its default profile into mke2fs and lib/support installs nothing.
#
# Use the GitHub release archive: it extracts to e2fsprogs-1.47.4/ and ships a
# prebuilt ./configure. The kernel.org path 404s at this version.
./configure \
    --host="$HOST" \
    --prefix=/usr \
    --libdir=/usr/lib \
    --sbindir=/usr/bin \
    --bindir=/usr/bin \
    --localstatedir=/var \
    --runstatedir=/run \
    --with-root-prefix=/ \
    --disable-libuuid \
    --disable-libblkid \
    --disable-nls \
    --disable-uuidd \
    --disable-install-chroot \
    --disable-backtrace \
    --enable-fsck \
    --enable-hardening

make -j${JOBS:-$(nproc)}

# DESTDIR, not `make install prefix=': e2fsprogs expands root_sysconfdir,
# root_sbindir and root_bindir at configure time from --with-root-prefix, so a
# prefix override would install into /etc, /sbin and /bin on the builder.
make DESTDIR="$dest" install
# --- what this package installs that the image must not ship ------------------

# /usr/libexec is not allowed by verify.sh; e2scrub is a standalone background
# scrubber, against the systemd-first rule. Drop its units and udev rules too.
rm -rf "$dest/usr/libexec"
rm -f  "$dest/usr/bin/e2scrub" "$dest/usr/bin/e2scrub_all"
rm -f  "$dest/usr/lib/systemd/system/e2scrub"*.service \
       "$dest/usr/lib/systemd/system/e2scrub"*.timer
rm -f  "$dest/usr/lib/udev/rules.d/e2scrub.rules" \
       "$dest/usr/lib/udev/rules.d/ext4.rules"
rm -f  "$dest/etc/cron.d/e2scrub_all" "$dest/etc/e2scrub.conf"

# #!/bin/* scripts: verify.sh rejects them (no /bin). compile_et and mk_cmds are
# build-time generators already used; e2scrub was removed above.
rm -f "$dest/usr/bin/compile_et" "$dest/usr/bin/mk_cmds"

# Development payload: static libs, headers, pkgconfig, info docs. Remove by
# name, never by directory: out/ is shared, and a bare rm -rf would take other
# packages' headers with it.
rm -f  "$dest/usr/lib/libcom_err.a" "$dest/usr/lib/libss.a" \
       "$dest/usr/lib/libe2p.a" "$dest/usr/lib/libext2fs.a"
rm -rf "$dest/usr/include/et" "$dest/usr/include/ss" \
       "$dest/usr/include/e2p" "$dest/usr/include/ext2fs"
rm -f  "$dest/usr/lib/pkgconfig/com_err.pc" "$dest/usr/lib/pkgconfig/ss.pc" \
       "$dest/usr/lib/pkgconfig/e2p.pc" "$dest/usr/lib/pkgconfig/ext2fs.pc"
rm -rf "$dest/usr/share/et" "$dest/usr/share/info"

# Fold root_-prefixed installs back under /usr. A no-op in 1.47.4 (configure
# points them at /usr), kept so a future release trips verify.sh here rather than
# shipping a root that references /bin.
for d in bin sbin lib; do
    if [ -d "$dest/$d" ]; then
        if [ "$d" = lib ]; then t=lib; else t=bin; fi
        mkdir -p "$dest/usr/$t"
        cp -a "$dest/$d/." "$dest/usr/$t/"
        rm -rf "$dest/$d"
    fi
done
if [ -d "$dest/usr/local" ]; then
    cp -a "$dest/usr/local/." "$dest/usr/"
    rm -rf "$dest/usr/local"
fi
if [ -d "$dest/usr/var" ]; then
    mkdir -p "$dest/var"
    cp -a "$dest/usr/var/." "$dest/var/"
    rm -rf "$dest/usr/var"
fi

# verify.sh rejects absolute symlinks leaving /usr,/etc,/var; rewrite them
# relative to their directory. A no-op in 1.47.4, which makes its aliases
# relative; mkfs.ext4 is e2fsprogs' own and is exec'd by name.
for d in "$dest/usr/bin" "$dest/usr/sbin"; do
    [ -d "$d" ] || continue
    find "$d" -type l | while read -r l; do
        tgt=$(readlink "$l")
        case "$tgt" in
            /usr/*|/etc/*|/var/*) ;;
            /*)
                rel=$(printf '%s\n' "${tgt#/}" | sed 's|[^/]\+|..|g')
                ln -sfn "$rel" "$l"
                ;;
        esac
    done
done

# Present: mkfs.ext4 must exist by that name because repart execs mkfs.<fstype>.
for t in mke2fs mkfs.ext4 e2fsck fsck.ext4 tune2fs dumpe2fs resize2fs; do
    if [ ! -e "$dest/usr/bin/$t" ]; then
        echo "e2fsprogs: $t missing from the install" >&2
        exit 1
    fi
done

# Absent: the pruned names, so verify.sh is a backstop rather than the detector.
for gone in e2scrub e2scrub_all compile_et mk_cmds; do
    if [ -e "$dest/usr/bin/$gone" ]; then
        echo "e2fsprogs: $gone should have been pruned but is present" >&2
        exit 1
    fi
done
if [ -d "$dest/usr/libexec" ]; then
    echo "e2fsprogs: /usr/libexec survived" >&2
    exit 1
fi

# mke2fs compiles its default profile in and compares it with /etc/mke2fs.conf;
# its absence means --with-root-prefix and DESTDIR interacted unexpectedly.
if [ ! -f "$dest/etc/mke2fs.conf" ]; then
    echo "e2fsprogs: /etc/mke2fs.conf missing from the install" >&2
    echo "  --with-root-prefix and DESTDIR interact here; check misc/Makefile.in:628" >&2
    exit 1
fi
