#!/bin/sh -e

dest="$1"
cd coreutils-0.12.0

cargo build --release --locked --features unix

install -Dm755 target/release/coreutils "$dest/usr/bin/coreutils"

for util in \
    arch base32 base64 basename basenc b2sum cat chgrp chmod chown \
    chroot cksum comm csplit cut date dd dircolors dir dirname du \
    echo env expand expr factor false fmt fold groups head hostid \
    hostname id install join kill link ln logname ls md5sum mkdir \
    mknod mkfifo mktemp more mv nice nl nohup nproc numfmt od paste \
    pathchk pinky printenv printf pr ptx pwd readlink realpath rm \
    rmdir runcon seq sha1sum sha224sum sha256sum sha384sum sha512sum \
    shred shuf sleep sort split stat stdbuf stty sum sync tac tail \
    tee test timeout touch tr true truncate tsort tty uname unexpand \
    uniq unlink uptime users vdir wc who whoami yes
do
    ln -sf coreutils "$dest/usr/bin/$util"
done
